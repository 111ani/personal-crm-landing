---
import { solutions } from "../../data/content";
import Eyebrow from "../Eyebrow.astro";
import Icon from "../Icon.astro";
---

<section class="bg-bg-alt">
  <div class="mx-auto flex max-w-1200 flex-col items-center px-24 pt-56 pb-60 md:px-40 md:py-110">
    <Eyebrow>Решение</Eyebrow>
    <h2 class="mt-14 max-w-860 text-center font-serif text-heading-long font-medium md:mt-20">
      Личная CRM собирает всё о ваших контактах в одном месте и подсказывает, <i class="font-normal text-accent"
        >когда пора напомнить о себе</i
      >
    </h2>

    <ul
      class="mt-32 flex flex-col gap-10 self-stretch md:mt-56 md:grid md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))] md:gap-16"
    >
      {
        solutions.map((solution) => (
          <li class="flex gap-14 rounded-card bg-bg p-18 md:flex-col md:gap-18 md:p-30">
            <Icon name={solution.icon} class="size-28 shrink-0 md:size-34 md:stroke-[1.3]" />
            <div class="flex flex-col gap-6 md:gap-10">
              <h3 class="font-serif text-card-title font-medium">{solution.title}</h3>
              <p class="text-card-text text-muted">{solution.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
