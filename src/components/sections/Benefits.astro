---
import { benefits, formatNumber } from "../../data/content";
import Eyebrow from "../Eyebrow.astro";
---

<section class="mx-auto flex max-w-1200 flex-col items-center px-24 pt-56 pb-60 md:px-40 md:py-110">
  <Eyebrow>Выгоды</Eyebrow>
  <h2 class="mt-14 text-center font-serif text-heading font-medium md:mt-18">
    Что <i class="font-normal text-accent">изменится</i>
  </h2>

  <ol
    class="mt-30 flex flex-col self-stretch md:mt-64 md:grid md:grid-cols-[repeat(auto-fit,minmax(320px,1fr))] md:gap-x-56"
  >
    {
      benefits.map((benefit, index) => (
        <li class="flex flex-col gap-8 border-t border-line py-20 last:border-b md:gap-12 md:py-30 md:last:border-b-0">
          <div class="flex items-baseline gap-12 md:gap-16">
            <span class="font-serif text-benefit-number text-accent italic">{formatNumber(index)}</span>
            <h3 class="font-serif text-benefit-title font-medium">{benefit.title}</h3>
          </div>
          <p class="pl-34 text-card-text text-muted md:pl-42">{benefit.text}</p>
        </li>
      ))
    }
  </ol>
</section>
